# diagnose case 配置样板:cp 到 ~/.arkagent/cases/diagnose/config.env 后填写(文件权限 0600)
ARK_API_KEY=""
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# 排障 Agent / Environment(由 ma-resources 创建)
DIAGNOSE_AGENT_ID=""
DIAGNOSE_ENVIRONMENT_ID=""

# 与被排查的 bot 同机部署:指向它们的库(至少配一个,未配置的 bot 不参与排查)
TOPICX_CONTROL_DB_PATH=""
TOPIC5_PIPELINE_DB_PATH=""
TOPIC6_PIPELINE_DB_PATH=""
# 通用 Gateway 类 bot(各一个库,默认在 ~/.arkagent/cases/<case>/gateway.db)
ANALYST_GATEWAY_DB_PATH=""
ADA_PM_GATEWAY_DB_PATH=""
# 数字员工(默认在 ~/.arkagent/cases/digital-employee/topic_bot_sessions.db)
DIGITAL_EMPLOYEE_SESSION_DB_PATH=""

# 可选:限定谁能用排障 Bot(open_id,逗号分隔);留空不限制
AUTHORIZED_OPEN_IDS=""


# ---- session 日志定时落飞书文档(可选;不设 SESSION_DOC_PARENT_TOKEN 就完全不启用)----
# 父节点 token(wiki 节点或文件夹);排障应用须有 docx:document:create / write_only 且是该空间成员
SESSION_DOC_PARENT_TOKEN=""
# SESSION_DOC_INTERVAL_S=120        # 周期(秒),默认 2 分钟
# SESSION_DOC_LOOKBACK_DAYS=7       # 只看最近几天内开始的 session
# SESSION_DOC_MAX_PER_CYCLE=20      # 单周期最多检查几个 session
# SESSION_DOC_DB_PATH=              # 同步进度库,默认放在排障 case 目录下
