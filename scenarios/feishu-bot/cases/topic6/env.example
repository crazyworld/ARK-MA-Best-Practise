# topic6 case 的环境变量样板。
# 用法:
#   cp scenarios/feishu-bot/cases/topic6/env.example ~/.arkagent/cases/topicX/config.env
#   编辑真实值,然后 `python3 -m arkagent run --case topicx`
# CLI 启动时会自动加载该文件。

# ---- 方舟鉴权(必填;仅用于 Managed Agent 控制面:Agent/Environment/Session/Skill 管理) ----
ARK_API_KEY="your-ark-api-key"
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# ---- 飞书 Bot(必填,`arkagent init --case topicx` 扫码后自动写入) ----
FEISHU_APP_ID="cli_xxxx"
FEISHU_APP_SECRET="xxxx"

# ---- topic6 MA 资源(必填,由 cases/topic6/ma-resources/create_all.sh 输出) ----
TOPIC6_COORDINATOR_AGENT_ID="agent-xxxx"
TOPIC6_ENVIRONMENT_ID="env-xxxx"

# ---- 可选 ----
# HITL 长任务状态库路径;缺省 ./data/topic6_pipeline.db
TOPIC6_PIPELINE_DB_PATH=""
# Session outputs 本地同步目录;缺省 cases/topic6/data/artifacts
TOPIC6_ARTIFACT_SYNC_DIR=""
# 方舟 Files API 轮询间隔(秒)
TOPIC6_ARTIFACT_POLL_INTERVAL_SEC="60"
# topic6 长任务的 Memory Store id(用于 coordinator 读写记忆);留空表示不挂载
TOPIC6_MEMORY_STORE_ID=""
# 可选的共享 Vault；妙搭用户 OAuth 不填这里，由 authorize_miaoda_user.py
# 自动创建每用户独立 Vault，并在 Session 创建时按消息发送者挂载
ARK_VAULT_ID=""
# 允许触发的飞书 open_id 白名单(逗号分隔;留空=不限)
AUTHORIZED_OPEN_IDS=""
# 管理员 open_id(逗号分隔):回复他人任务的进度卡片发 /continue 可替其续跑;留空=仅发起人
TOPIC6_ADMIN_OPEN_IDS=""

# ---- 模型网关 bmc-llm-relay(blueai 模型资源,必填) ----
# 4 个 Agent(agents/*.json 的 model.provider=bmc-llm-relay)走 BYOK Direct:Gateway 发消息时
# 按请求附加 X-User-Model-Header-<NAME>: <VALUE>。coordinator 走 relay 时两者缺一 Gateway 启动即失败。
BYOK_MODEL_AUTH_HEADER_NAME="Authorization"
BYOK_MODEL_AUTH_HEADER_VALUE="Bearer your-bmc-llm-relay-key"
# ma-resources/skills 内脚本(topic6-insight/topic6-event-registry/topic6-annotation)直连模型
# 用的网关地址/Key;只读这两个,不回退 ARK_*(ARK_* 只用于调方舟 Managed Agent 控制面)。
LLM_RELAY_BASE_URL="https://bmc-llm-relay.bluemediagroup.cn/v1"
LLM_RELAY_API_KEY="your-bmc-llm-relay-key"

# ---- 多环境隔离(可选) ----
# 同一方舟账号跑多套 topic6(dev/staging/prod 或多人各自开发)时,给本环境的
# Agent/Environment/MemoryStore 名称加专属后缀,避免按 name 查找/删除时跟别的环境撞车。
# 见 ma-resources/create_all.sh 的"多环境隔离"说明。
TOPIC6_RESOURCE_SUFFIX=""
